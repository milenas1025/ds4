<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title</title>
    <link rel="stylesheet" href="~/Content/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <style>
        body {
            background-color: #f0f2f5;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            color: #333;
        }

        .navbar {
            background-color: #2c3e50;
            box-shadow: 0 4px 6px rgba(0,0,0,0.2);
        }

        .navbar-brand {
            font-weight: bold;
            font-size: 1.6rem;
            color: #fff !important;
            transition: color 0.3s;
        }

            .navbar-brand:hover {
                color: #ffc107 !important;
            }

        .navbar-nav .nav-link {
            color: #e0e0e0 !important;
            font-weight: 500;
            margin-right: 10px;
            position: relative;
            transition: all 0.3s;
        }

            .navbar-nav .nav-link::after {
                content: '';
                display: block;
                height: 2px;
                width: 0%;
                background: #ffc107;
                transition: width 0.3s;
                position: absolute;
                bottom: 0;
                left: 0;
            }

            .navbar-nav .nav-link:hover {
                color: #ffc107 !important;
            }

                .navbar-nav .nav-link:hover::after {
                    width: 100%;
                }

        .container {
            margin-top: 30px;
        }

        .card {
            background-color: #ffffff;
            border-radius: 12px;
            padding: 25px;
            box-shadow: 0 6px 15px rgba(0,0,0,0.1);
            transition: all 0.3s;
        }

            .card:hover {
                transform: translateY(-3px);
                box-shadow: 0 10px 25px rgba(0,0,0,0.15);
            }

        table {
            background-color: #f8f9fa;
            border-radius: 8px;
            width: 100%;
        }

            table th {
                background-color: #000000;
                color: #ffffff;
                transition: background 0.3s;
            }

                table th:hover {
                    background-color: #333333;
                }

            table td {
                padding: 10px;
                text-align: center;
                vertical-align: middle !important;
                color: #212529;
            }

            table.table-hover tbody tr:hover {
                background-color: #e0e0e0;
                cursor: pointer;
            }

        input.form-control, select.form-control {
            border-radius: 6px;
            background-color: #ffffff;
            color: #212529;
            border: 1px solid #ced4da;
            transition: all 0.3s;
        }

            input.form-control:focus, select.form-control:focus {
                border-color: #007bff;
                box-shadow: 0 0 5px rgba(0,123,255,0.5);
            }

            input.form-control::placeholder {
                color: #6c757d;
            }

        .btn-primary {
            background-color: #007bff;
            border-color: #007bff;
            font-weight: 500;
            transition: all 0.3s;
        }

            .btn-primary:hover {
                background-color: #0056b3;
                border-color: #004085;
                color: #fff;
                transform: translateY(-2px);
                box-shadow: 0 4px 10px rgba(0,0,0,0.2);
            }

        footer {
            margin-top: 50px;
            text-align: center;
            padding: 15px 0;
            color: #6c757d;
            font-size: 0.9rem;
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand navbar-dark">
        <a class="navbar-brand" href="#">Clínica Salud Vital</a>
        <ul class="navbar-nav">
            <li class="nav-item"><a class="nav-link" href="/PacientesView/Index">Pacientes</a></li>
            <li class="nav-item"><a class="nav-link" href="/MedicosView/Index">Médicos</a></li>
            <li class="nav-item"><a class="nav-link" href="/CitasView/Index">Citas</a></li>
            <li class="nav-item"><a class="nav-link" href="/ReportesView/Index">Reportes</a></li>
        </ul>
    </nav>
    <div class="container">
        @RenderBody()
    </div>
    <footer>
        © 2025 Clínica Salud Vital - Todos los derechos reservados
    </footer>
    @RenderSection("scripts", required: false)
</body>
</html>
